### This config file contains required core defaults that must be set, along with a handful of common optional settings.
### For a full list of available settings, see https://microsoft.github.io/graphrag/config/yaml/

### LLM settings ###

completion_models:
  default_chat_model:
    model_provider: ${MODEL_PROVIDER}
    model: ${RAG_CHAT_MODEL}
    auth_method: api_key
    api_key: ${LLM_API_KEY}
    # 질의응답(local_search/global_search) 전용 모델. api_base 지정 시 로컬 vLLM으로 라우팅.
    # 비워두면 기존처럼 실제 OpenAI로 요청이 감.
    api_base: ${RAG_CHAT_API_BASE}
    call_args:
      temperature: 0
      # 개방형/요약형 질문(예: "누가 주로 어떤 말을 해?")에서 같은 문구·항목을 반복하며
      # 늘어지는 현상 방지용. indexing_chat_model_reports에 이미 쓰던 것과 같은 패턴
      # (당시도 반복 생성 문제 대응 목적). 학습(SFT) 손실 계산과는 무관한 디코딩 시점
      # 설정이라 파인튜닝된 모델과의 프롬프트 일치 여부와는 상관없이 안전하게 조절 가능.
      frequency_penalty: 0.4

    # retry/rate_limit: 인덱싱(graphrag indwx/update)에만 적용. 쿼리와는 무관
    retry:
      type: exponential_backoff
      max_retries: 10
    rate_limit:
      type: sliding_window
      period_in_seconds: 60
      tokens_per_period: 180000   # TPP==TPM

  # 로컬 vLLM(mailgrapher-llama-v4) — 인덱싱 전용. OpenAI 호환 API라 provider는 openai 그대로,
  # api_base만 로컬 서버로 지정. api_key는 vLLM이 값 검증은 하되 실제 인증은 안 하므로 더미값 사용.
  indexing_chat_model:
    model_provider: openai
    model: ${INDEXING_CHAT_MODEL}
    auth_method: api_key
    api_key: ${LOCAL_API_KEY}
    api_base: ${INDEXING_API_BASE}
    call_args:
      temperature: 0
      max_tokens: 6000   # 반복/장문 생성으로 안 멈추는 경우 대비 하드 캡 (max_input_length=5500과 합쳐도 max_model_len=12288 안에 여유 있게 들어옴)

    retry:
      type: exponential_backoff
      max_retries: 10

  indexing_chat_model_reports:
    model_provider: openai
    model: ${INDEXING_CHAT_MODEL}
    auth_method: api_key
    api_key: ${LOCAL_API_KEY}
    api_base: ${INDEXING_API_BASE}
    call_args:
      temperature: 0
      max_tokens: 6000   # 반복/장문 생성으로 안 멈추는 경우 대비 하드 캡 (max_input_length=5500과 합쳐도 max_model_len=12288 안에 여유 있게 들어옴)
      frequency_penalty: 0.4

    retry:
      type: exponential_backoff
      max_retries: 10

embedding_models:
  # 지금은 아무 워크플로우도 embedding_model_id로 이 이름을 안 씀(전부 indexing_embedding_model 사용) —
  # 사실상 미사용 블록이지만, GraphRAG config 스키마상 완전히 지우면 로드 단계에서 에러 날 위험이
  # 있어 안전하게 남겨두고, 대신 로컬 bge-m3(8001)를 가리키도록 해둠 — OpenAI로 나가는 경로 자체를 제거.
  default_embedding_model:
    model_provider: openai
    model: ${INDEXING_EMBEDDING_MODEL}
    auth_method: api_key
    api_key: ${LOCAL_API_KEY}
    api_base: ${INDEXING_EMBEDDING_API_BASE}

    # retry/rate_limit: 인덱싱(embed_text 워크플로우)에만 적용. 쿼리와는 무관
    retry:
      type: exponential_backoff
      max_retries: 10
    rate_limit:
      type: sliding_window
      period_in_seconds: 60
      tokens_per_period: 180000

  # 로컬 vLLM(bge-m3) — 인덱싱 전용
  indexing_embedding_model:
    model_provider: openai
    model: ${INDEXING_EMBEDDING_MODEL}
    auth_method: api_key
    api_key: ${LOCAL_API_KEY}
    api_base: ${INDEXING_EMBEDDING_API_BASE}

    retry:
      type: exponential_backoff
      max_retries: 10

concurrent_requests: 50 # v3부터 모델별이 아니라 전역 설정
async_mode: threaded

### Document processing settings ###

input:
  type: csv
  encoding: utf-8
  file_pattern: ".*\\.csv$$"
  id_column: "id"       # 기존 source_column
  text_column: "text"

chunking:
  size: 1500     # 2000 → 600 → 1500
  overlap: 150  # 100 → 150
  encoding_model: o200k_base
  # group_by_columns 없음 - v3는 문서(행) 단위로 항상 독립 청킹하므로 동일 효과 보장됨

### Storage settings ###
## If blob storage is specified in the following four sections,
## connection_string and container_name must be provided

input_storage:
  type: file
  base_dir: "input"

output_storage:
  type: file
  base_dir: "output"

## only turn this on if running `graphrag index` with custom settings
## we normally use `graphrag update` with the defaults
update_output_storage:
  type: file
  base_dir: "update_output"

reporting:
  type: file # or console, blob
  base_dir: "logs"

cache:
  type: json          # 캐시 "포맷" (json/memory/none) - 기존 type:file과 다른 의미
  storage:
    type: file         # 캐시 "저장 위치"는 이제 여기
    base_dir: "cache"

vector_store:
  type: lancedb
  db_uri: output/lancedb

### Workflow settings ###

embed_text:
  embedding_model_id: ${INDEXING_EMBEDDING_MODEL_ID}
  names: [entity_description]
  # community_full_content.lance: drift search 전용. 추가 확장 가능성 존재
  # text_unit_text.lanc: basic search 전용. 현재 local이 basic 커버하므로 확장 불필요 예상

extract_graph:
  completion_model_id: ${INDEXING_COMPLETION_MODEL_ID}
  prompt: "prompts/extract_graph.txt"
  entity_types: [{% for et in entity_types %}{{ et.name }}{% if not loop.last %}, {% endif %}{% endfor %}] # 추출하고자 하는 핵심 도메인 개체 정의
  max_gleanings: 0

summarize_descriptions:
  completion_model_id: ${INDEXING_COMPLETION_MODEL_ID}
  prompt: "prompts/summarize_descriptions.txt"
  max_length: 400 # 300에서 상향

extract_claims:
  completion_model_id: default_chat_model
  enabled: false
  prompt: "prompts/extract_claims.txt"
  description: "Any claims or facts that could be relevant to information discovery."
  max_gleanings: 0

community_reports:
  completion_model_id: ${INDEXING_REPORTS_MODEL_ID}
  graph_prompt: "prompts/community_reports.txt"
  max_length: 2000 # 생성되는 커뮤니티 요약 리포트의 최대 토큰 수 (출력 제한, 모델에게 주는 지시일 뿐 강제 아님)
  max_input_length: 5500 # Context Window에 포함될 최대 토큰 수 (입력 제한) - v4 max_model_len=12288 기준 출력 여유 확보를 위해 하향
  # text_prompt 생략 → graphrag 내장 기본 프롬프트로 대체됨

cluster_graph:
  max_cluster_size: 8 # 20 → 15 → 8, v4가 community_reports 요약을 안정적으로 못 만드는 지나치게 큰 커뮤니티(엔티티 80개+) 발생 방지

snapshots:
  graphml: true
  embeddings: false
  # raw_entities / top_level_nodes / transient 필드는 v3에 없음

{% if local_search %}
local_search:
  completion_model_id: default_chat_model
  embedding_model_id: ${INDEXING_EMBEDDING_MODEL_ID}
  prompt: "prompts/local_search.txt"
  text_unit_prop: 0.5 # 전체 Contetxt Window에서 Source Doucument가 차지하는 비율. 50%
  community_prop: 0.1 # Context Window에서 Community Report가 차지하는 비율. 10%
  top_k_entities: 30 # 질문 시 벡터 검색으로 추출할 엔티티의 최대 개수
  top_k_relationships: 30 # 추출된 엔티티간 엣지의 최대 개수
  max_context_tokens: 6000 # Context Window의 최대 토큰
{% endif %}

{% if global_search %}
global_search:
  completion_model_id: default_chat_model
  map_prompt: "prompts/global_search_map.txt"
  reduce_prompt: "prompts/global_search_reduce.txt"
  knowledge_prompt: "prompts/global_search_knowledge.txt"
{% endif %}